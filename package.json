{
  "name": "mcpperm",
  "version": "0.1.0",
  "description": "Local-first MCP manifest permission profiler and policy generator.",
  "type": "module",
  "bin": {
    "mcpperm": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "fixtures",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run package:smoke"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "permissions",
    "cli",
    "policy"
  ],
  "author": "StackForge User",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  }
}
